#2#
rawlis=["State->TN~City->Chennai","State->Kerla~City-Trivandrum"]
print()
print("===rawlist==")
print(rawlis)

rddlis=sc.parallelize(rawlis)
print()
print("===rddd lis==")
print(rddlis.collect())

flatdata=rddlis.flatMap(lambda X:X.split("~"))
print()
print("===flat map list==")
print(flatdata.collect())

statefill=flatdata.filter(lambda X : "State"  in X)
print()
print("===filter state ==")
print(statefill.collect())

cityfill=flatdata.filter(lambda X : "City" in X)
print()
print("===filter city ==")
print(cityfill.collect())

states =statefill.map(lambda X : X.replace("State->",""))
print()
print("===final states  ==")
print(states.collect())

cities=cityfill.map(lambda X : X.replace("City->",""))
print()
print("===final city ==")
print(states.collect())

