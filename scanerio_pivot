# scnnario pivot means column value convert in column name #

from pyspark.sql.functions import *
data = [
    (101, "Eng", 90),
    (101, "Sci", 80),
    (101, "Mat", 95),
    (102, "Eng", 75),
    (102, "Sci", 85),
    (102, "Mat", 90)
]
columns = ["Id", "Subject", "Marks"]
rdd = spark.sparkContext.parallelize(data)
df = rdd.toDF(columns)
df.show()

pivotdf = (
df.groupBy("Id")
.pivot("Subject")
.agg(first("Marks"))
)

pivotdf.show()

