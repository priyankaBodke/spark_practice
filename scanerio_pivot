from pyspark.sql.functions import *

data = [
    ('A', 'D', 'D'),
    ('B', 'A', 'A'),
    ('A', 'D', 'A')
]

df = spark.createDataFrame(
    data,
    ["TeamA", "TeamB", "Won"]
)

df.show()

# Combine TeamA and TeamB
teams_df = df.selectExpr(
    "stack(2, TeamA, TeamB) as TeamName",
    "Won"
)

# Calculate total wins
result_df = teams_df.groupBy("TeamName").agg(
    sum(
        when(col("TeamName") == col("Won"), 1)
        .otherwise(0)
    ).alias("Won")
)

result_df.orderBy("TeamName").show()

#op#

+-----+-----+---+
|TeamA|TeamB|Won|
+-----+-----+---+
|    A|    D|  D|
|    B|    A|  A|
|    A|    D|  A|
+-----+-----+---+

+--------+---+
|TeamName|Won|
+--------+---+
|       A|  2|
|       B|  0|
|       D|  1|
+--------+---+

